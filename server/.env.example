NODE_ENV=development
PORT=5000
# Local MongoDB or an Atlas connection string (see README)
MONGODB_URI=mongodb://127.0.0.1:27017/nutrition_tracker
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# 'lax' for same-site (dev proxy / same domain). Use 'none' when the API and client are on different domains in production.
COOKIE_SAMESITE=lax
# Nutrition data source: 'local' (seeded DB). Add providers in src/providers/ for external APIs.
FOOD_PROVIDER=local
